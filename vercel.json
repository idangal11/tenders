{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 -c \"import json;json.load(open('site/data/tenders.json'));json.load(open('site/data/meta.json'))\"",
  "outputDirectory": "site",
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ]
}
